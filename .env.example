# Core simulator identity
ROBOT_DEVICE_ID=device-test

# Optional recorded-camera / LiveKit workflow
ROS2_RECORDINGS_DIR=./recordings
FRONT_BAG=/recordings/front_cam.mcap
LEFT_BAG=/recordings/left_cam.mcap
RIGHT_BAG=/recordings/right_cam.mcap
FRONT_CAMERA_TOPIC=/astra2_cam/color/image_raw
LEFT_CAMERA_TOPIC=/cam_eth/color/image_raw
RIGHT_CAMERA_TOPIC=/cam_usb/color/image_raw
