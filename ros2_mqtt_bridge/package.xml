<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_mqtt_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 telemetry simulator and bidirectional MQTT bridge.</description>
  <maintainer email="vaishnavmankar04@gmail.com">Vaishnav Mankar</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>rcl_interfaces</depend>
  <exec_depend>python3-paho-mqtt</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
